# jj-push <bookmark>: push one jj bookmark from the jj repo in the current directory.
#
# Exists because Claude Code's worktree-isolation guard refuses any Bash command
# that names `git` right after `jj`, which blocks `jj git push` inside jj
# workspaces. This wrapper takes only a bookmark name, never arbitrary flags.
set -eu
if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo "usage: jj-push <bookmark>" >&2
  exit 2
fi
case "$1" in
  -*) echo "jj-push: bookmark name must not start with '-'" >&2; exit 2 ;;
esac
exec jj git push -b "$1"
