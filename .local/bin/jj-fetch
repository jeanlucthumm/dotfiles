#!/bin/sh
# jj-fetch: fetch all remotes into the jj repo in the current directory.
#
# Exists because Claude Code's worktree-isolation guard refuses any Bash command
# that names `git` as an operand of a command it does not recognise, which blocks
# `jj git fetch` inside jj workspaces. Takes no arguments: workspaces share the
# repo store, so a fetch from any workspace updates remote-tracking bookmarks
# for all of them. Sibling of jj-push.
set -eu
if [ "$#" -ne 0 ]; then
  echo "usage: jj-fetch   (no arguments)" >&2
  exit 2
fi
exec jj git fetch
